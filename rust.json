uint32_t decryption::encrypt_fov(float input) {
    uint32_t v = std::bit_cast<uint32_t>(input);
    v = (v << 2) | (v >> 30);
    v ^= 0xBF1B783Du;
    v = (v << 5) | (v >> 27);
    return v;
}

uint32_t decryption::decrypt_fov(uint32_t v) {
    v = (v << 27) | (v >> 5);
    v ^= 0xBF1B783Du;
    v = (v << 30) | (v >> 2);
    return v;
}

