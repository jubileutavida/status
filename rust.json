// clActiveItem  — in-place, result is UID not a handle
// rol 28, add 0x4163CC9A, xor 0x3C9AE79B
uint64_t clActiveItem(uint64_t a1) {
    uint32_t* p = (uint32_t*)&a1;
    for (int i = 0; i < 2; i++) {
        uint32_t v = p[i];
        v  = (v << 28) | (v >> 4);
        v += 0x4163CC9Au;
        v ^= 0x3C9AE79Bu;
        p[i] = v;
